generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  google
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskStatus {
  PENDING
  COMPLETED
  MISSED
}

enum Mood {
  LOCKED_IN
  GOOD
  TIRED
  BURNED_OUT
  DISTRACTED
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  email    String  @unique
  password String?

  provider AuthProvider @default(local)

  // Gamification
  currentXP      Int       @default(0)
  totalXP        Int       @default(0)
  level          Int       @default(1)
  streak         Int       @default(0)
  lastActiveDate DateTime?

  devMode Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks    Task[]
  journals Journal[]

  @@map("users")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  difficulty  Difficulty @default(EASY)
  status      TaskStatus @default(PENDING)
  completedAt DateTime?
  expiresAt   DateTime

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("tasks")
}

model Journal {
  id String @id @default(cuid())

  // Normalized to midnight UTC — one row per user per calendar day
  date DateTime

  // Entry fields (all optional so partial saves are allowed)
  completed     String?
  distractedBy  String?
  biggestWin    String?
  tomorrowFocus String?
  mood          Mood    @default(GOOD)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One entry per user per day
  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
  @@map("journals")
}
