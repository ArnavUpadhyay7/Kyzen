generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  google
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskStatus {
  PENDING
  COMPLETED
  MISSED
}

enum Mood {
  LOCKED_IN
  GOOD
  TIRED
  BURNED_OUT
  DISTRACTED
}

enum IdeaCategory {
  PROJECT
  STARTUP
  TOOL
  EXPERIMENT
}

enum ProjectStatus {
  PLANNING
  BUILDING
  SHIPPING
  PAUSED
}

enum InspirationType {
  UI
  REPO
  DESIGN
  CONCEPT
}

enum NoteCategory {
  DSA
  COMMAND
  INTERVIEW
  LEARNING
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  email    String  @unique
  password String?

  provider AuthProvider @default(local)

  // Gamification
  currentXP      Int       @default(0)
  totalXP        Int       @default(0)
  level          Int       @default(1)
  streak         Int       @default(0)
  lastActiveDate DateTime?

  devMode Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks         Task[]
  battleLogs    BattleLog[]
  ideas         WorkspaceIdea[]
  projects      WorkspaceProject[]
  inspirations  WorkspaceInspiration[]
  notes         WorkspaceNote[]

  @@map("users")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  difficulty  Difficulty @default(EASY)
  status      TaskStatus @default(PENDING)
  completedAt DateTime?
  expiresAt   DateTime

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("tasks")
}

model BattleLog {
  id String @id @default(cuid())

  // Normalized to midnight UTC — one row per user per calendar day
  date DateTime

  mood      Mood @default(GOOD)
  completed String?
  win       String?
  learned   String?
  bug       String?
  tomorrow  String?

  xpEarned  Int @default(0)
  userLevel Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
  @@map("battle_logs")
}

model WorkspaceIdea {
  id       String       @id @default(cuid())
  title    String
  category IdeaCategory @default(PROJECT)
  problem  String?
  tags     String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workspace_ideas")
}

model WorkspaceProject {
  id          String        @id @default(cuid())
  name        String
  description String?
  why         String?
  mvp         String[]      @default([])
  stretch     String[]      @default([])
  tech        String[]      @default([])
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workspace_projects")
}

model WorkspaceInspiration {
  id    String          @id @default(cuid())
  type  InspirationType
  title String
  url   String
  tag   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workspace_inspirations")
}

model WorkspaceNote {
  id       String       @id @default(cuid())
  category NoteCategory
  title    String
  content  String
  tags     String[]     @default([])
  isCode   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workspace_notes")
}
